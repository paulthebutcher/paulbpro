{% from 'components.njk' import nav,arrow,headingText %}
<div class="section {% if entry.data.kindOfPage == 'cases' %}on-pine{% else %}on-alabaster{% endif %}"><div class="frame">{{ nav(site) }}<main id="main" class="detail inset"><a class="back mono" href="/{% if entry.data.kindOfPage == 'cases' %}#work{% else %}#build{% endif %}">← {% if entry.data.kindOfPage == 'cases' %}{{ site.ui.work }}{% else %}{{ site.ui.build }}{% endif %}</a><h1 class="display2">{{ headingText(entry.data.title) }}</h1><p class="mono muted">{% if entry.data.kindOfPage == 'cases' %}{{ entry.data.org }} · {{ entry.data.years }} · {{ entry.data.role }}{% else %}{{ entry.data.kind }} · {{ entry.data.status }}{% if entry.data.stack.length %} · {{ entry.data.stack | join(', ') }}{% endif %}{% endif %}</p><p class="intro">{{ entry.data.summary }}</p><div class="detail-image">{% media entry.data.image,entry.data.imageAlt,708,400 %}{% if entry.data.imageCaption %}<p class="mono muted">{{ entry.data.imageCaption }}</p>{% endif %}</div><div class="prose">{{ entry.body | gapMarkup | safe }}</div>{% if entry.data.pull %}<blockquote class="closing">{{ entry.data.pull }}</blockquote>{% endif %}<nav class="pagination">{% if entry.previous %}<a href="{{ entry.previous.url }}">← {{ site.ui.previous }} {{ entry.previous.title }}</a>{% endif %}{% if entry.next %}<a href="{{ entry.next.url }}">{{ site.ui.next }} {{ entry.next.title }} →</a>{% endif %}</nav></main></div></div>{% include 'footer.njk' %}
