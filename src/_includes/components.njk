{% macro arrow(kind='right') %}<svg class="icon-arrow{% if kind == 'outbound' %} outbound{% endif %}" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="{% if kind == 'download' %}M10 2v11m-5-5 5 5 5-5M3 14v4h14v-4{% else %}M2 10h15m-6-6 6 6-6 6{% endif %}"/></svg>{% endmacro %}
{% macro buttonIcon(kind='right') %}<span class="button-icon button-icon--{{ kind }}" aria-hidden="true">{{ arrow(kind) }}</span>{% endmacro %}
{% macro button(item,site) %}{% set href = item | resolveHref %}{% if href | available %}<a class="button {{ item.style or 'filled' }}" href="{{ href }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}{% if item.external %}<span class="visually-hidden">{{ site.ui.external }}</span>{% endif %}{{ buttonIcon(item.icon) }}</a>{% else %}<span class="button {{ item.style or 'filled' }} unavailable" aria-disabled="true" title="{{ site.ui.unavailable }}">{{ item.label }}{{ buttonIcon(item.icon) }}<span class="visually-hidden">{{ site.ui.unavailable }}</span></span>{% endif %}{% endmacro %}
{% macro tag(label) %}<div class="section-tag-row"><p class="section-tag mono">{{ label }}</p></div>{% endmacro %}
{% macro nav(site) %}<header class="nav"><div class="identity"><a href="/">{{ site.site.name }}</a><span class="muted">{{ site.site.title }}</span></div><nav aria-label="{{ site.ui.navigation }}">{% for item in site.nav %}<a href="/{{ item.href }}" data-nav="{{ item.href }}">{{ item.label }}</a>{% endfor %}</nav></header>{% endmacro %}
